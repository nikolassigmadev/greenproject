# Server runtime data (disputes, OpenAI call logs, etc.) — never commit.
# Anchor to project root so it does NOT match src/data/ (where shipped data lives).
#
# Excluding the DIRECTORY would stop git descending into it at all, so the
# negation below could never match. Exclude the CONTENTS instead, then re-admit
# the one file we do publish.
/data/*
!/data/README.md

# Claude Code internal worktrees — accidentally tracked as submodules; never commit.
.claude/worktrees/
.claude/settings.local.json


# Research artifacts — big downloads and generated fixtures, not app code.
scripts/research/**/*.parquet
scripts/research/**/cache/

# Local scratch notes — never commit personal paths or shell history
pullpush.txt
git-commands.txt

# Generated demo data for the impact card (regenerate with scripts/mock/make-demo-backup.mjs)
goodscan-demo-backup.json

# Raw reference datasets live in data/reference/ and are already covered by
# /data/* above. Refetch them with scripts/supplychain/fetch_reference_data.sh;
# the BUNDLED, converted forms in src/data/supplyChain/ are committed instead.
