# Frontend Configuration
# Optional — the app defaults to the production backend (https://goodscan.shop).
# Set this to use a local server during development.
VITE_BACKEND_URL=http://localhost:3001

# Backend Configuration
OPENAI_API_KEY=your_openai_api_key_here
PORT=3001

# OpenAI spend guard. The per-IP rate limiter does NOT bound the bill — IPs are
# free, so a scraper rotating addresses or a front-page link can bill you
# without limit. These two do bound it.
#
# OPENAI_DAILY_CALL_BUDGET is the global circuit breaker: once this many OpenAI
# calls have been made today (UTC), every AI endpoint returns 503 until
# midnight. This is the number that protects the account.
# OPENAI_DAILY_CALLS_PER_USER stops one device eating that global budget.
#
# Counters live in memory: a restart resets them, and each instance behind a
# load balancer keeps its own. They also count CALLS, not dollars. So treat
# these as a complement to — never a replacement for — a hard monthly spend cap
# set in the OpenAI dashboard. See docs/launch-gates.md.
OPENAI_DAILY_CALL_BUDGET=5000
OPENAI_DAILY_CALLS_PER_USER=120

# Admin login. REQUIRED to use the admin surface — there is no fallback hash.
# When this is unset, /api/admin/login and every /api/admin/* route return 503.
# That is intentional: an unconfigured deployment has no admin at all, rather
# than an admin whose password hash is readable in a public repo.
# Generate a hash with:
#   ./scripts/make-admin-hash.sh
# or: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
# ADMIN_PASSWORD_HASH=

# Postgres scan log (optional). Set to a Supabase/Neon/Railway connection string
# to record every AI analysis (full response + metadata) to the ai_scans table.
# Leave unset to disable — the server runs fine without it.
# Supabase: Project Settings → Database → Connection string → URI (port 5432).
DATABASE_URL=
# Set to "false" only if connecting to a local Postgres without TLS.
# DATABASE_SSL=false

# Optional staging origin, exact scheme+host, e.g. https://goodscan.hostingersite.com
# Absent by default. Never widen this to a whole shared-hosting domain: anyone
# can register a subdomain there, and CORS here sends credentials.
# STAGING_ORIGIN=
